    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "baseline-browser-mapping": "^2.10.38",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
